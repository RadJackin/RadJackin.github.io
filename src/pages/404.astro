---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="404 · 页面不存在" description="这个地址下没有内容。">
  <div class="wrap">
    <div class="nf">
      <div>
        <div class="code">404</div>
        <h1>这个页面不存在</h1>
        <p>可能是链接拼错了，也可能是文章被我改了地址。</p>
        <a class="btn" href="/">← 回到首页</a>
        <a class="btn" href="/posts/" style="margin-left:8px">看看全部日志</a>
      </div>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="搜索" description="站内搜索：按标题、摘要、标签实时过滤。">
  <div class="wrap">
    <header class="page-head">
      <h1>搜索</h1>
      <p>输入关键词，实时过滤标题、摘要和标签。索引在构建时生成，不依赖服务器。</p>
    </header>

    <div class="search-box">
      <label class="sr-only" for="q">搜索关键词</label>
      <input id="q" type="search" placeholder="试试「搜索」「Astro」「写作」" autocomplete="off" />
    </div>
    <p class="search-hint" id="hint">正在加载索引…</p>

    <div class="results" id="results">
      <div class="empty">输入关键词开始搜索</div>
    </div>
  </div>

  <script>
    type Item = { title: string; description: string; slug: string; tags: string[]; date: string };

    const input = document.getElementById('q') as HTMLInputElement | null;
    const box = document.getElementById('results') as HTMLElement | null;
    const hint = document.getElementById('hint') as HTMLElement | null;
    let items: Item[] = [];

    const esc = (s: string) =>
      s.replace(/[&<>"]/g, (c) => (({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' } as Record<string, string>)[c] ?? c));

    fetch('/search.json')
      .then((r) => r.json())
      .then((d: Item[]) => {
        items = d;
        if (hint) hint.textContent = `已加载 ${items.length} 篇文章的索引`;
      })
      .catch(() => {
        if (hint) hint.textContent = '索引加载失败：请确认站点已完整构建';
      });

    const render = () => {
      if (!input || !box) return;
      const q = input.value.trim().toLowerCase();
      if (!q) {
        box.innerHTML = '<div class="empty">输入关键词开始搜索</div>';
        return;
      }
      const hits = items.filter((p) =>
        `${p.title} ${p.description} ${p.tags.join(' ')}`.toLowerCase().includes(q)
      );
      if (hits.length === 0) {
        box.innerHTML = '<div class="empty">没有匹配的文章 —— 试试更短的关键词</div>';
        return;
      }
      box.innerHTML = hits
        .map(
          (p) =>
            `<a class="result" href="/posts/${p.slug}/"><b>${esc(p.title)}</b><p>${esc(p.description)}</p></a>`
        )
        .join('');
    };

    input?.addEventListener('input', render);
    input?.focus();
  </script>
</BaseLayout>
